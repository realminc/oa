  "port_provenance": {
    "classification": "mechanical_adaptation_with_compatibility_ids",
    "donors": [
      "tools/gen/fn/schema/core/coreFnMatrixElemwise.toml",
      "source/cpp/lib/oa/core/fnmatrix/fnMatrix.cpp",
      "source/cpp/lib/oa/core/fnmatrix/elemwise/fnMatrixElemwise.cpp",
      "source/cpp/lib/oa/core/shader/compute/flat/addBcast.slang",
      "source/cpp/lib/oa/core/shader/compute/flat/subBcast.slang",
      "source/cpp/lib/oa/core/shader/compute/flat/divBcast.slang",
      "source/cpp/lib/oa/core/autograd/matrix/autogradElemwise.h",
      "source/cpp/lib/oa/core/autograd/matrix/autogradElemwise.gen.h"
    ],
    "reason": "Preserves OA Add/Sub/Mul/Div multidirectional broadcasting and sum-to-input-shape adjoints while retaining the existing exact-shape candidates, and ports Log, Sqrt, scalar arithmetic, Exp, Reciprocal, and clamp reverse formulas needed by policy composition. OARS corrects the donor GradClampMax/GradClampMin masks, which propagate through the clamped side: Rust uses the mathematical inclusive derivative on the retained side and proves both boundaries on Vulkan. Broadcast candidates use OARS compatibility IDs because donor-local registry identities are not globally unique in the current Rust registry."
  },
  "contracts": {
    "binary": {
      "input_kinds": ["matrix", "matrix"],
      "output_kinds": ["matrix"],
      "shape_rule": "equal_no_broadcast",
      "dtype_rule": "same_admitted_dtype",
      "effects": ["read_inputs", "write_output"],
      "mutated_inputs": [],
      "output_alias_inputs": [-1],
      "differentiation": "none",
      "lowering": "compute_dispatch"
    },
    "unary": {
      "input_kinds": ["matrix"],
      "output_kinds": ["matrix"],
      "shape_rule": "preserve_input",
      "dtype_rule": "all_f32",

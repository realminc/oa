{
  "schema": "oa.benchmark_suite.v1",
  "workloads": [
    {
      "name": "runtime.roofline.copy",
      "command_id": "BenchDeviceRoofline.CopyBandwidth.v1",
      "command": ["{binary_root}/test/runtime/profiling/benchDeviceRoofline", "--gtest_filter=BenchDeviceRoofline.CopyBandwidth"],
      "contract": {"dtype": "fp32", "algorithmic_bytes": "read+write", "copy_mib": "128", "metric": "effective_not_counter_bandwidth"},
      "metric_regex": "OAROOFLINE[^\\n]*probe=copy[^\\n]*effective_gbps=(?P<value>[0-9.]+)",
      "metric_name": "copy_effective_bandwidth",
      "metric_unit": "GB/s",
      "direction": "higher",
      "cooldown": 5.0,
      "max_spread_percent": 10.0,
      "thermal_limit_celsius": 70.0,
      "thermal_sensor_regex": "coretemp:.*:Package id 0",
      "thermal_timeout": 600.0,
      "require_regex": ["clock_calibrated=1", "dispatches=1 submissions=1", "\\[  PASSED  \\] 1 test"]
    },
    {
      "name": "runtime.roofline.fp32_gemm",

{
  "schema": "oars.benchmark_suite.v1",
  "workloads": [
    {
      "name": "core.matmul_nt.square_512",
      "command_id": "oars.core.matmul_nt.f32.m512.n512.k512.v1",
      "command": ["{binary_root}/sdk/benchmarks/core/core_mat_mul_bench", "--name", "square-512", "--m", "512", "--n", "512", "--k", "512", "--device", "{device_index}", "--warmup", "5", "--samples", "20"],
      "contract": {"dtype": "f32", "layout": "left_mk_right_nk", "m": "512", "n": "512", "k": "512", "route": "matrix_mat_mul_nt_tiled_f32", "fallback": "none", "boundary": "captured_plan_gpu_timestamp"},
      "metric_regex": "OARS_BENCH[^\\n]*gpu_median_ms=(?P<value>[0-9.]+)",
      "metric_name": "gpu_median",
      "metric_unit": "ms",
      "warmup": 2,
      "runs": 7,
      "cooldown": 2.0,
      "max_spread_percent": 25.0,
      "require_regex": ["correctness=pass", "unexpected_fallbacks=0", "route=matrix_mat_mul_nt_tiled_f32"]
    },

  "types": [
    {
      "category": "detection",
      "name": "NmsConfig",
      "before": "nms",
      "kind": "struct",
      "visibility": "pub",
      "derive": [
        "Clone",
        "Copy",
        "Debug",
        "PartialEq"
      ],
      "doc": "Deterministic non-maximum-suppression policy.",
      "fields": [
        {
          "name": "iou_threshold",
          "type": "f32",
          "visibility": "pub",
          "doc": "Suppress a same-class box when its IoU is at least this value."
        },
        {
          "name": "score_threshold",
          "type": "f32",
          "visibility": "pub",
          "doc": "Ignore candidates below this score."
        },
        {
          "name": "max_detections",
          "type": "i32",
          "visibility": "pub",
          "doc": "Maximum number of selected source rows."
        },
        {
          "name": "class_agnostic",
          "type": "bool",
          "visibility": "pub",
          "doc": "Suppress overlaps across class labels when true."
        }
      ],
      "variants": [],
      "defaults": {
        "iou_threshold": "0.45",
        "score_threshold": "0.0",
        "max_detections": "100",
        "class_agnostic": "false"
      },
      "default_variant": null
    },
    {
      "category": "detection",
      "name": "NmsResult",
      "before": "nms",
      "kind": "struct",
      "visibility": "pub",

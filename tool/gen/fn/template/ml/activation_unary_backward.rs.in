pub(in crate::ml) fn {{name}}(
	{{saved_param}}: &Matrix,
	output_gradient: &Matrix,
) -> Result<Matrix> {
	let contract = {{contract}};
	let operation = contract.name();
	let engine = {{saved_param}}.engine_handle();
	for matrix in &[{{saved_param}}, output_gradient] {
		if matrix.dtype() != DType::F32 {
			return Err(Error::invalid_argument(format!(
				"{operation} requires F32 matrices; found {}",
				matrix.dtype().token()
			)));
		}
		if !engine.same_as(matrix.engine_handle()) {
			return Err(Error::invalid_argument(format!(
				"{operation} inputs must belong to the same engine"
			)));
		}
	}
	if {{saved_param}}.shape() != output_gradient.shape() {
		return Err(Error::invalid_argument(format!(
			"{operation} requires matching shapes"
		)));
	}
	let element_count = u32::try_from({{saved_param}}.num_elements())
		.map_err(|_| Error::invalid_argument(format!("{operation} element count exceeds u32")))?;
	let gradient = Matrix::allocate(
		engine,
		{{saved_param}}.shape().to_vec(),
		{{saved_param}}.num_elements(),
		DType::F32,
	)?;
	if element_count != 0 {
		let buffers = [
			BufferBinding::read({{saved_param}}.storage()),
			BufferBinding::read(output_gradient.storage()),
			BufferBinding::write(gradient.storage()),
		];
		let push_constants = [PushConstant::U32(element_count)];
		engine.record_semantic(
			ComputeDispatch {
				kernel: KernelId::{{kernel}},
				buffers: &buffers,
				push_constants: &push_constants,
				workgroups: KernelId::{{kernel}}.linear_workgroups(element_count),
			},
			SemanticDispatch {
				contract,
				inputs: &[{{saved_param}}, output_gradient],
				outputs: &[&gradient],
				attributes: &[],
			},
		)?;
	}
	Ok(gradient)
}

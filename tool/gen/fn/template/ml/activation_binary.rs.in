/// {{doc}}
///
/// # Errors
///
/// Returns an error unless both inputs are equal-shape F32 on the same runtime,
/// or runtime recording fails.
pub fn {{name}}(
	{{left}}: &Matrix,
	{{right}}: &Matrix,
) -> Result<Matrix> {
	let contract = {{contract}};
	let operation = contract.name();
	let runtime = {{left}}.runtime();
	for matrix in &[{{left}}, {{right}}] {
		if matrix.dtype() != DType::F32 {
			return Err(Error::invalid_argument(format!(
				"{operation} requires F32 matrices; found {}",
				matrix.dtype().token()
			)));
		}
		if !runtime.same_as(matrix.runtime()) {
			return Err(Error::invalid_argument(format!(
				"{operation} inputs must belong to the same runtime"
			)));
		}
	}
	if {{left}}.shape() != {{right}}.shape() {
		return Err(Error::invalid_argument(format!(
			"{operation} requires equal input shapes"
		)));
	}
	let element_count = u32::try_from({{left}}.num_elements())
		.map_err(|_| Error::invalid_argument(format!("{operation} element count exceeds u32")))?;
	let output = Matrix::allocate(
		runtime,
		{{left}}.shape().to_vec(),
		{{left}}.num_elements(),
		DType::F32,
	)?;
	if element_count != 0 {
		let buffers = [
			BufferBinding::read({{left}}.storage()),
			BufferBinding::read({{right}}.storage()),
			BufferBinding::write(output.storage()),
		];
		let push_constants = [PushConstant::U32(element_count)];
		runtime.record_semantic(
			ComputeDispatch {
				kernel: KernelId::{{kernel}},
				buffers: &buffers,
				push_constants: &push_constants,
				workgroups: KernelId::{{kernel}}.linear_workgroups(element_count),
				indirect: None,
			},
			SemanticDispatch {
				contract,
				inputs: &[{{left}}, {{right}}],
				outputs: &[&output],
				attributes: &[],
			},
		)?;
	}
{{autograd_call}}
	Ok(output)
}

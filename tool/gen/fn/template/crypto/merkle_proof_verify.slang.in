// OA donor: source/cpp/lib/oa/crypto/hash.cpp, verifyMerkleProof.
// Adaptation: canonical self-describing frames, device flags, checked ranges.
// Each invocation owns one U32 result; invalid content always yields zero.
import attributes;
import merkle_pair;
struct PushConstants {
{{fields}}
};
[[vk::push_constant]] PushConstants push;
[[vk::binding(0, 0)]] RWByteAddressBuffer storage_buffers[];
[kernel_name("{{name}}")]
[domain("cryptography")]
[variant("generic")]
[dtype("{{dtype}}")]
[status("experimental")]
[shader("compute")]
[numthreads({{workgroup}})]
void main(uint3 dispatch_thread_id : SV_DispatchThreadID) {
	uint row = dispatch_thread_id.x;
	if (row >= push.count) return;
	uint leaf_extent, proof_extent, root_extent, output_extent;
	storage_buffers[push.leaves_index].GetDimensions(leaf_extent);
	storage_buffers[push.proofs_index].GetDimensions(proof_extent);
	storage_buffers[push.roots_index].GetDimensions(root_extent);
	storage_buffers[push.output_index].GetDimensions(output_extent);
	if (push.frame_bytes < {{header_bytes}}u
		|| (push.frame_bytes - {{header_bytes}}u) % {{hash_bytes}}u != 0u
		|| (push.frame_bytes - {{header_bytes}}u) / {{hash_bytes}}u > {{max_depth}}u
		|| (push.root_count != 1u && push.root_count != push.count)
		|| push.count > leaf_extent / {{hash_bytes}}u || push.count > proof_extent / push.frame_bytes
		|| push.root_count > root_extent / {{hash_bytes}}u || push.count > output_extent / 4u) return;
	storage_buffers[push.output_index].Store<uint>(row * 4u, 0u);
	uint base = row * push.frame_bytes;
	uint version = storage_buffers[push.proofs_index].Load(base);
	uint nodes = storage_buffers[push.proofs_index].Load(base + 4u);
	uint index = storage_buffers[push.proofs_index].Load(base + 8u);
	uint valid = storage_buffers[push.proofs_index].Load(base + 12u);
	if (version != {{version}}u || nodes == 0u || nodes != push.leaf_count || index >= nodes || valid != 1u) return;
	uint depth = (push.frame_bytes - {{header_bytes}}u) / {{hash_bytes}}u;
	uint expected_depth = 0u;
	uint count = nodes;
	[loop]
	while (count > 1u) {
		count = count / 2u + (count & 1u);
		++expected_depth;
	}
	if (depth != expected_depth) return;
	uint current[8];
	[loop]
	for (uint word = 0u; word < 8u; ++word)
		current[word] = storage_buffers[push.leaves_index].Load(row * {{hash_bytes}}u + word * 4u);
	[loop]
	for (uint level = 0u; level < depth; ++level) {
		uint sibling_base = base + {{header_bytes}}u + level * {{hash_bytes}}u;
		bool sibling_left = (index & 1u) != 0u;
		if (!sibling_left && index + 1u == nodes) {
			// Canonical odd-tail proofs repeat the running node itself.
			uint mismatch = 0u;
			[loop]
			for (uint word = 0u; word < 8u; ++word)
				mismatch |= current[word] ^ storage_buffers[push.proofs_index].Load(sibling_base + word * 4u);
			if (mismatch != 0u) return;
		}
		merkle_hash_pair(current, storage_buffers[push.proofs_index], sibling_base, sibling_left);
		index >>= 1u;
		nodes = nodes / 2u + (nodes & 1u);
	}
	uint root_base = (push.root_count == 1u ? 0u : row) * {{hash_bytes}}u;
	uint mismatch = 0u;
	[loop]
	for (uint word = 0u; word < 8u; ++word)
		mismatch |= current[word] ^ storage_buffers[push.roots_index].Load(root_base + word * 4u);
	storage_buffers[push.output_index].Store<uint>(row * 4u, mismatch == 0u ? 1u : 0u);
}

from ._native import Engine, Matrix

class DeviceErasure:
	def try_is_complete(self) -> bool: ...
	def wait(self) -> None: ...

class DeviceMlDsaKey:
	@property
	def public_key(self) -> Matrix: ...
	def try_cleanup_complete(self) -> bool: ...
	def wait_cleanup(self) -> None: ...
	def erase(self) -> DeviceErasure: ...

class DeviceMlKemKey:
	@property
	def public_key(self) -> Matrix: ...
	def try_cleanup_complete(self) -> bool: ...
	def wait_cleanup(self) -> None: ...
	def erase(self) -> DeviceErasure: ...

class DeviceSharedSecret:
	def erase(self) -> DeviceErasure: ...

class DeviceSignature:
	@property
	def signature(self) -> Matrix: ...
	@property
	def status(self) -> Matrix: ...
	def try_cleanup_complete(self) -> bool: ...
	def wait_cleanup(self) -> None: ...

class DeviceEncapsulation:
	@property
	def ciphertext(self) -> Matrix: ...
	@property
	def status(self) -> Matrix: ...
	def take_shared_secret(self) -> DeviceSharedSecret: ...
	def try_cleanup_complete(self) -> bool: ...
	def wait_cleanup(self) -> None: ...

class DeviceDecapsulation:
	def take_shared_secret(self) -> DeviceSharedSecret: ...
	def try_cleanup_complete(self) -> bool: ...
	def wait_cleanup(self) -> None: ...

def crypto_device_mldsa_keygen(engine: Engine, parameters: int) -> DeviceMlDsaKey: ...
def crypto_device_mlkem_keygen(engine: Engine, parameters: int) -> DeviceMlKemKey: ...
def crypto_device_mldsa_sign(key: DeviceMlDsaKey, message: Matrix, context: Matrix, deterministic: bool = False) -> DeviceSignature: ...
def crypto_device_mldsa_sign_hash_message(key: DeviceMlDsaKey, message: Matrix, context: Matrix, algorithm: str, deterministic: bool = False) -> DeviceSignature: ...
def crypto_device_mldsa_sign_prehashed(key: DeviceMlDsaKey, digest: Matrix, context: Matrix, algorithm: str, deterministic: bool = False) -> DeviceSignature: ...
def crypto_device_mlkem_encapsulate(public_key: Matrix, parameters: int) -> DeviceEncapsulation: ...
def crypto_device_mlkem_decapsulate(key: DeviceMlKemKey, ciphertext: Matrix) -> DeviceDecapsulation: ...
def crypto_device_mldsa_verify_hash_message(parameters: int, algorithm: str, messages: Matrix, offsets: Matrix, lengths: Matrix, signatures: Matrix, public_keys: Matrix, context_start: int, context_end: int) -> Matrix: ...
def crypto_device_mldsa_verify_prehashed(parameters: int, algorithm: str, digests: Matrix, offsets: Matrix, lengths: Matrix, signatures: Matrix, public_keys: Matrix, context_start: int, context_end: int) -> Matrix: ...

def crypto_device_mldsa_verify_message(parameters: int, messages: Matrix, offsets: Matrix, lengths: Matrix, signatures: Matrix, public_keys: Matrix, context_start: int, context_end: int) -> Matrix: ...

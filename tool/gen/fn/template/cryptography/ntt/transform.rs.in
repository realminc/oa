use crate::{DType, Engine, Error, Matrix, OpAttribute, Result, runtime::{BufferBinding, ComputeDispatch, KernelId, PushConstant, SemanticDispatch}};
use super::config::{NttConfig, NttRepresentation, power_mod};

/// Reusable device twiddles and checked public field metadata.
///
/// This value retains its originating Engine through its Matrix allocations.
/// It has no independent execution owner and exposes no mutable twiddle storage.
#[derive(Clone)]
pub struct NttParameters {
	config: NttConfig,
	forward: Matrix,
	inverse: Matrix,
	negative_inverse: u32,
	r2: u64,
	inverse_length: u64,
}

impl NttParameters {
	/// Checked public field configuration.
	pub const fn config(&self) -> &NttConfig { &self.config }
}

/// Prepare forward/inverse Montgomery twiddles on the supplied Engine.
///
/// # Errors
/// Rejects allocation, queried workgroup limits, ABI or recording failures.
pub fn prepare(engine: &Engine, config: &NttConfig) -> Result<NttParameters> {
	let engine = engine.handle();
	let modulus = config.modulus;
	let root = config.root;
	let one = ((1_u128 << 64) % u128::from(modulus)) as u64;
	let r2 = ((u128::from(one) * u128::from(one)) % u128::from(modulus)) as u64;
	let root_montgomery = ((u128::from(root) * u128::from(one)) % u128::from(modulus)) as u64;
	let inverse_root = power_mod(root, modulus - 2, modulus);
	let inverse_root_montgomery = ((u128::from(inverse_root) * u128::from(one)) % u128::from(modulus)) as u64;
	let inverse_length = ((u128::from(power_mod(config.length as u64, modulus - 2, modulus)) * u128::from(one)) % u128::from(modulus)) as u64;
	let mut inverse = 1_u32;
	for _ in 0..5 { inverse = inverse.wrapping_mul(2_u32.wrapping_sub((modulus as u32).wrapping_mul(inverse))); }
	let negative_inverse = inverse.wrapping_neg();
	let count = (config.length / 2) as u32;
	let groups = engine.linear_dispatch_grid(count, 128)?;
	let forward = Matrix::allocate_output(&engine, vec![config.length / 2, 2], config.length, DType::U32)?;
	let inverse = Matrix::allocate_output(&engine, vec![config.length / 2, 2], config.length, DType::U32)?;
	let kernel = KernelId::CryptographyNttTwiddlesU32;
	let buffers = [BufferBinding::write(forward.storage()), BufferBinding::write(inverse.storage())];
	let push_constants = [PushConstant::U32(count), PushConstant::U32(groups[0] * 128),
		PushConstant::U32(modulus as u32), PushConstant::U32((modulus >> 32) as u32), PushConstant::U32(negative_inverse),
		PushConstant::U32(root_montgomery as u32), PushConstant::U32((root_montgomery >> 32) as u32),
		PushConstant::U32(inverse_root_montgomery as u32), PushConstant::U32((inverse_root_montgomery >> 32) as u32),
		PushConstant::U32(one as u32), PushConstant::U32((one >> 32) as u32)];
	let attributes = [OpAttribute::UnsignedInteger { name: "modulus".into(), value: modulus }, OpAttribute::UnsignedInteger { name: "length".into(), value: config.length as u64 }];
	engine.record_semantic(
		ComputeDispatch { kernel, buffers: &buffers, push_constants: &push_constants, workgroups: groups },
		SemanticDispatch { contract: crate::core::operation::cryptography::ntt::NTT_TWIDDLES, inputs: &[], outputs: &[&forward, &inverse], attributes: &attributes },
	)?;
	Ok(NttParameters { config: config.clone(), forward, inverse, negative_inverse, r2, inverse_length })
}

{{transforms}}

/// Multiply pointwise in the configured prime field, preserving representation.
///
/// # Errors
/// Rejects dtype, shape, ownership, address limits, allocation or recording failures.
pub fn pointwise_multiply(left: &Matrix, right: &Matrix, parameters: &NttParameters) -> Result<Matrix> {
	let config = &parameters.config;
	if left.dtype() != DType::U32 || left.shape().len() != 3 || left.shape()[1..] != [config.length, 2]
		|| right.dtype() != DType::U32 || right.shape() != left.shape()
		|| !left.engine_handle().same_as(right.engine_handle()) || !left.engine_handle().same_as(parameters.forward.engine_handle()) {
		return Err(Error::invalid_argument("NTT pointwise multiplication requires matching-owner U32 [batch, length, 2] rows"));
	}
	let elements = left.num_elements();
	let bytes = elements.checked_mul(4).ok_or_else(|| Error::invalid_argument("NTT byte extent overflows usize"))?;
	u32::try_from(bytes).map_err(|_| Error::invalid_argument("NTT byte extent exceeds u32"))?;
	let count = u32::try_from(elements / 2).map_err(|_| Error::invalid_argument("NTT coefficient count exceeds u32"))?;
	let engine = left.engine_handle();
	let output = Matrix::allocate_output(engine, left.shape().to_vec(), elements, DType::U32)?;
	if count != 0 {
		let groups = engine.linear_dispatch_grid(count, 128)?;
		let kernel = KernelId::CryptographyNttPointwiseU32;
		let buffers = [BufferBinding::read(left.storage()), BufferBinding::read(right.storage()), BufferBinding::write(output.storage())];
		let push_constants = [PushConstant::U32(count), PushConstant::U32(groups[0] * 128), PushConstant::U32(config.modulus as u32), PushConstant::U32((config.modulus >> 32) as u32), PushConstant::U32(parameters.negative_inverse), PushConstant::U32(parameters.r2 as u32), PushConstant::U32((parameters.r2 >> 32) as u32), PushConstant::U32(u32::from(config.representation == NttRepresentation::Montgomery))];
		let attributes = [OpAttribute::UnsignedInteger { name: "modulus".into(), value: config.modulus }, OpAttribute::UnsignedInteger { name: "length".into(), value: config.length as u64 }, OpAttribute::UnsignedInteger { name: "montgomery".into(), value: u64::from(config.representation == NttRepresentation::Montgomery) }];
		engine.record_semantic(
			ComputeDispatch { kernel, buffers: &buffers, push_constants: &push_constants, workgroups: groups },
			SemanticDispatch { contract: crate::core::operation::cryptography::ntt::NTT_POINTWISE, inputs: &[left, right], outputs: &[&output], attributes: &attributes },
		)?;
	}
	Ok(output)
}

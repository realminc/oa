// Tape traversal adapters; numerical adjoints live beside forward providers.

// @operation copy
// @fields input,output_id
let Some(output_gradient) = gradients.take_output(*output_id) else {
return Ok(false);
};
let input_gradient = matrix::copy_backward(output_gradient)?;
gradients.accumulate(input.value_id(), input_gradient)?;
Ok(true)

// @operation add
// @fields left,right,output_id
let Some(output_gradient) = gradients.take_output(*output_id) else {
return Ok(false);
};
let (left_gradient, right_gradient) = matrix::add_backward(left, right, &output_gradient)?;
gradients.accumulate(left.value_id(), left_gradient)?;
gradients.accumulate(right.value_id(), right_gradient)?;
Ok(true)

// @operation mul
// @fields left,right,output_id
let Some(output_gradient) = gradients.take_output(*output_id) else {
return Ok(false);
};
let (left_gradient, right_gradient) = matrix::mul_backward(left, right, &output_gradient)?;
gradients.accumulate(left.value_id(), left_gradient)?;
gradients.accumulate(right.value_id(), right_gradient)?;
Ok(true)

// @operation div
// @fields left,right,output_id
let Some(output_gradient) = gradients.take_output(*output_id) else {
return Ok(false);
};
let (left_gradient, right_gradient) = matrix::div_backward(left, right, &output_gradient)?;
gradients.accumulate(left.value_id(), left_gradient)?;
gradients.accumulate(right.value_id(), right_gradient)?;
Ok(true)

// @operation scale
// @fields input,output_id,scalar
let Some(output_gradient) = gradients.take_output(*output_id) else {
return Ok(false);
};
let input_gradient = matrix::scale_backward(&output_gradient, *scalar)?;
gradients.accumulate(input.value_id(), input_gradient)?;
Ok(true)


let Some(output_gradient) = gradients.take_output(*output_id) else {
return Ok(false);
};
let input_gradient = matrix::reciprocal_backward(output, &output_gradient)?;
gradients.accumulate(input.value_id(), input_gradient)?;
Ok(true)


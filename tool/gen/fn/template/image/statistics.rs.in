	let contract = {{contract}};
	let (batch, channels, image_height, image_width) = image_extent(input, contract.name())?;
	let plane_count = batch
		.checked_mul(channels)
		.ok_or_else(|| Error::out_of_range("image::orb plane count exceeds u32"))?;
	let feature_cap = if max_features == 0 {

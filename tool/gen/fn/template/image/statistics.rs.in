	let query_count = query.shape()[0];
	let train_count = train.shape()[0];
	if query_count == 0 || train_count == 0 {
		return Err(Error::invalid_argument(
			"image::bf_match requires nonempty descriptor sets",
		));
	}
	let query_count_u32 = u32::try_from(query_count)
		.map_err(|_| Error::out_of_range("image::bf_match query count exceeds u32"))?;
	let train_count_u32 = u32::try_from(train_count)
		.map_err(|_| Error::out_of_range("image::bf_match train count exceeds u32"))?;
	let desc_len_u32 = u32::try_from(desc_len)
		.map_err(|_| Error::out_of_range("image::bf_match descriptor width exceeds u32"))?;
	let output = Matrix::allocate(
		query.runtime(),
		vec![query_count, 4],
		query_count
			.checked_mul(4)
			.ok_or_else(|| Error::out_of_range("image::bf_match output size exceeds u32"))?,
		DType::F32,
	)?;
	let attributes = [{{attributes}}];
	query.runtime().record_image_semantic(
		ComputeDispatch {
			kernel: {{kernel:0}},
			buffers: &[{{bindings:0}}],
			push_constants: &[{{push:0}}],
			workgroups: {{workgroups:0}},
			indirect: None,
		},
		ImageSemanticDispatch {
			contract: {{contract}},
			inputs: &[
				ImageSemanticInput::Matrix(query),
				ImageSemanticInput::Matrix(train),
			],
			outputs: &[ImageSemanticOutput::Matrix(&output)],
			attributes: &attributes,
		},
	)?;
	Ok(output)
// @operation good_features_to_track
	if !quality.is_finite() || !(0.0..=1.0).contains(&quality) || !min_distance.is_finite() || min_distance < 0.0 {
		return Err(Error::invalid_argument(
			"image::good_features_to_track requires quality in [0, 1] and finite min_distance >= 0",
		));
	}
	let contract = {{contract}};
	let (batch, channels, image_height, image_width) = image_extent(input, contract.name())?;
	let plane_count = batch
		.checked_mul(channels)
		.ok_or_else(|| Error::out_of_range("image::good_features_to_track plane count exceeds u32"))?;
	let corner_cap = if max_corners == 0 {
		image_height
			.checked_mul(image_width)
			.ok_or_else(|| Error::out_of_range("image::good_features_to_track plane size exceeds u32"))?
	} else {
		max_corners
	};
	let row_elements = plane_count
		.checked_mul(image_height)
		.ok_or_else(|| Error::out_of_range("image::good_features_to_track scratch size exceeds u32"))?;
	let row_max = Matrix::allocate(
		input.runtime(),
		vec![row_elements as usize],
		row_elements as usize,
		DType::F32,
	)?;
	let thresholds = Matrix::allocate(
		input.runtime(),
		vec![plane_count as usize],
		plane_count as usize,
		DType::F32,
	)?;
	let counts = Matrix::allocate(
		input.runtime(),
		vec![plane_count as usize],
		plane_count as usize,
		DType::U32,
	)?;
	let keypoints = Matrix::allocate(
		input.runtime(),
		vec![plane_count as usize, corner_cap as usize, 3],
		plane_count
			.checked_mul(corner_cap)
			.and_then(|count| count.checked_mul(3))
			.ok_or_else(|| Error::out_of_range("image::good_features_to_track keypoint size exceeds u32"))? as usize,
		DType::F32,
	)?;
	let {{binding_name:0}} = [{{bindings:0}}];
	let {{push_name:0}} = [{{push:0}}];
	let {{binding_name:1}} = [{{bindings:1}}];
	let {{push_name:1}} = [{{push:1}}];
	let {{binding_name:2}} = [{{bindings:2}}];
	let {{push_name:2}} = [{{push:2}}];
	let {{binding_name:3}} = [{{bindings:3}}];
	let {{push_name:3}} = [{{push:3}}];
	let attributes = [{{attributes}}];
	input.runtime().record_image_split_semantic(
		&[
			ComputeDispatch {
				kernel: {{kernel:0}},
				buffers: &{{binding_name:0}},
				push_constants: &{{push_name:0}},
				workgroups: {{workgroups:0}},
				indirect: None,
			},
			ComputeDispatch {
				kernel: {{kernel:1}},
				buffers: &{{binding_name:1}},
				push_constants: &{{push_name:1}},
				workgroups: {{workgroups:1}},
				indirect: None,
			},
			ComputeDispatch {
				kernel: {{kernel:2}},
				buffers: &{{binding_name:2}},
				push_constants: &{{push_name:2}},
				workgroups: {{workgroups:2}},
				indirect: None,
			},
			ComputeDispatch {
				kernel: {{kernel:3}},
				buffers: &{{binding_name:3}},
				push_constants: &{{push_name:3}},
				workgroups: {{workgroups:3}},
				indirect: None,
			},
		],
		ImageSemanticDispatch {
			contract,
			inputs: &[ImageSemanticInput::Image(input)],
			outputs: &[
				ImageSemanticOutput::Matrix(&keypoints),
				ImageSemanticOutput::Matrix(&counts),
			],
			attributes: &attributes,
		},
	)?;
	Ok((keypoints, counts))

// @operation orb
	if !quality.is_finite() || !(0.0..=1.0).contains(&quality) || !min_distance.is_finite() || min_distance < 0.0 {
		return Err(Error::invalid_argument(
			"image::orb requires quality in [0, 1] and finite min_distance >= 0",
		));
	}
	if levels == 0 || edge < 18 {
		return Err(Error::invalid_argument(
			"image::orb requires levels >= 1 and edge >= 18 for the rotated BRIEF support",
		));
	}
	let contract = {{contract}};
	let (batch, channels, image_height, image_width) = image_extent(input, contract.name())?;
	let plane_count = batch
		.checked_mul(channels)
		.ok_or_else(|| Error::out_of_range("image::orb plane count exceeds u32"))?;
	let feature_cap = if max_features == 0 {
		image_height
			.checked_mul(image_width)
			.ok_or_else(|| Error::out_of_range("image::orb plane size exceeds u32"))?
	} else {
		max_features
	};
	let level_cap = feature_cap;
	let keypoints = Matrix::allocate(
		input.runtime(),
		vec![plane_count as usize, feature_cap as usize, 6],
		plane_count
			.checked_mul(feature_cap)
			.and_then(|count| count.checked_mul(6))
			.ok_or_else(|| Error::out_of_range("image::orb keypoint size exceeds u32"))? as usize,
		DType::F32,
	)?;
	let descriptors = Matrix::allocate(
		input.runtime(),
		vec![plane_count as usize, feature_cap as usize, 8],
		plane_count
			.checked_mul(feature_cap)
			.and_then(|count| count.checked_mul(8))
			.ok_or_else(|| Error::out_of_range("image::orb descriptor size exceeds u32"))? as usize,
		DType::U32,
	)?;
	let counts = Matrix::allocate(
		input.runtime(),
		vec![plane_count as usize],
		plane_count as usize,
		DType::U32,
	)?;
	let {{binding_name:0}} = [{{bindings:0}}];
	let {{push_name:0}} = [{{push:0}}];
	let mut level_images = Vec::with_capacity(levels as usize);
	let mut level_dims = Vec::with_capacity(levels as usize);
	let mut level_states = Vec::with_capacity(levels as usize);
	level_images.push(input.clone());
	level_dims.push((image_width, image_height, 1.0f32));
	for _ in 1..levels {
		let next = crate::image::pyr_down(
			level_images
				.last()
				.ok_or_else(|| Error::internal("image::orb pyramid level missing"))?,
		)?;
		let (width, height, scale) = level_dims[level_dims.len() - 1];
		level_dims.push((width.div_ceil(2), height.div_ceil(2), scale * 2.0));
		level_images.push(next);
	}
	for level_image in &level_images {
		let score_map = crate::image::corner_fast(level_image, 9)?;
		let (level_keypoints, level_counts) =
			crate::image::good_features_to_track(&score_map, level_cap, quality, min_distance)?;
		level_states.push((level_keypoints, level_counts));
	}
	let mut describe_sets = Vec::with_capacity(levels as usize);
	let mut describe_pushes = Vec::with_capacity(levels as usize);
	for level in 0..levels {
		let level_image = &level_images[level as usize];
		let level_keypoints = &level_states[level as usize].0;
		let level_counts = &level_states[level as usize].1;
		let (level_width, level_height, level_scale) = level_dims[level as usize];
		let {{binding_name:1}} = [{{bindings:1}}];
		let {{push_name:1}} = [{{push:1}}];
		describe_sets.push({{binding_name:1}});
		describe_pushes.push({{push_name:1}});
	}
	let attributes = [{{attributes}}];
	let mut dispatches = Vec::with_capacity(describe_sets.len() + 1);
	dispatches.push(ComputeDispatch {
		kernel: {{kernel:0}},
		buffers: &{{binding_name:0}},
		push_constants: &{{push_name:0}},
		workgroups: {{workgroups:0}},
		indirect: None,
	});
	for (buffers, push_constants) in describe_sets.iter().zip(describe_pushes.iter()) {
		dispatches.push(ComputeDispatch {
			kernel: {{kernel:1}},
			buffers: buffers.as_slice(),
			push_constants: push_constants.as_slice(),
			workgroups: {{workgroups:1}},
			indirect: None,
		});
	}
	input.runtime().record_image_split_semantic(
		&dispatches,
		ImageSemanticDispatch {
			contract,
			inputs: &[ImageSemanticInput::Image(input)],
			outputs: &[
				ImageSemanticOutput::Matrix(&keypoints),
				ImageSemanticOutput::Matrix(&descriptors),
				ImageSemanticOutput::Matrix(&counts),
			],
			attributes: &attributes,
		},
	)?;
	Ok((keypoints, descriptors, counts))

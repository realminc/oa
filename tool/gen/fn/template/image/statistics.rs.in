			.checked_mul(feature_cap)
			.and_then(|count| count.checked_mul(8))
			.ok_or_else(|| Error::out_of_range("image::orb descriptor size exceeds u32"))? as usize,
		DType::U32,
	)?;
	let counts = Matrix::allocate(
		input.runtime(),
		vec![plane_count as usize],
		plane_count as usize,
		DType::U32,
	)?;
	let {{binding_name:0}} = [{{bindings:0}}];
	let {{push_name:0}} = [{{push:0}}];
	let mut level_images = Vec::with_capacity(levels as usize);
	let mut level_dims = Vec::with_capacity(levels as usize);
	let mut level_states = Vec::with_capacity(levels as usize);
	level_images.push(input.clone());
	level_dims.push((image_width, image_height, 1.0f32));
	for _ in 1..levels {
		let next = crate::image::pyr_down(
			level_images
				.last()
				.ok_or_else(|| Error::internal("image::orb pyramid level missing"))?,
		)?;
		let (width, height, scale) = level_dims[level_dims.len() - 1];
		level_dims.push((width.div_ceil(2), height.div_ceil(2), scale * 2.0));
		level_images.push(next);
	}
	for level_image in &level_images {
		let score_map = crate::image::corner_fast(level_image, 9)?;
		let (level_keypoints, level_counts) =
			crate::image::good_features_to_track(&score_map, level_cap, quality, min_distance)?;
		level_states.push((level_keypoints, level_counts));
	}
	let mut describe_sets = Vec::with_capacity(levels as usize);
	let mut describe_pushes = Vec::with_capacity(levels as usize);
	for level in 0..levels {
		let level_image = &level_images[level as usize];
		let level_keypoints = &level_states[level as usize].0;
		let level_counts = &level_states[level as usize].1;
		let (level_width, level_height, level_scale) = level_dims[level as usize];
		let {{binding_name:1}} = [{{bindings:1}}];
		let {{push_name:1}} = [{{push:1}}];
		describe_sets.push({{binding_name:1}});
		describe_pushes.push({{push_name:1}});
	}
	let attributes = [{{attributes}}];
	let mut dispatches = Vec::with_capacity(describe_sets.len() + 1);
	dispatches.push(ComputeDispatch {
		kernel: {{kernel:0}},
		buffers: &{{binding_name:0}},
		push_constants: &{{push_name:0}},
		workgroups: {{workgroups:0}},
		indirect: None,
	});
	for (buffers, push_constants) in describe_sets.iter().zip(describe_pushes.iter()) {
		dispatches.push(ComputeDispatch {
			kernel: {{kernel:1}},
			buffers: buffers.as_slice(),
			push_constants: push_constants.as_slice(),
			workgroups: {{workgroups:1}},
			indirect: None,
		});
	}
	input.runtime().record_image_split_semantic(
		&dispatches,
		ImageSemanticDispatch {
			contract,
			inputs: &[ImageSemanticInput::Image(input)],
			outputs: &[
				ImageSemanticOutput::Matrix(&keypoints),
				ImageSemanticOutput::Matrix(&descriptors),
				ImageSemanticOutput::Matrix(&counts),
			],
			attributes: &attributes,
		},
	)?;
	Ok((keypoints, descriptors, counts))
// @operation optical_flow_pyr_lk
	let (batch, channels, image_height, image_width) =
		validate_accumulation_pair(previous, next, "image::optical_flow_pyr_lk")?;
	if levels == 0 || window == 0 || iterations == 0 || !min_eigen.is_finite() || min_eigen <= 0.0 {
		return Err(Error::invalid_argument(
			"image::optical_flow_pyr_lk requires levels/window/iterations >= 1 and finite min_eigen > 0",
		));
	}
	if points.dtype() != DType::F32
		|| points.shape().len() != 2
		|| points.shape()[0] == 0
		|| points.shape()[1] != 2
	{
		return Err(Error::invalid_argument(
			"image::optical_flow_pyr_lk requires a nonempty F32 [N, 2] points matrix",
		));
	}
	let point_count = u32::try_from(points.shape()[0])
		.map_err(|_| Error::out_of_range("image::optical_flow_pyr_lk point count exceeds u32"))?;
	let support = window
		.checked_mul(2)
		.and_then(|value| value.checked_add(1))
		.ok_or_else(|| Error::out_of_range("image::optical_flow_pyr_lk window exceeds u32"))?;
	let plane_count = batch
		.checked_mul(channels)
		.ok_or_else(|| Error::out_of_range("image::optical_flow_pyr_lk plane count exceeds u32"))?;
	let state_elements = plane_count
		.checked_mul(point_count)
		.and_then(|count| count.checked_mul(2))
		.ok_or_else(|| Error::out_of_range("image::optical_flow_pyr_lk state size exceeds u32"))?;
	let map_elements = plane_count
		.checked_mul(point_count)
		.ok_or_else(|| Error::out_of_range("image::optical_flow_pyr_lk map size exceeds u32"))?;
	let contract = {{contract}};
	let mut previous_levels = Vec::with_capacity(levels as usize);
	let mut next_levels = Vec::with_capacity(levels as usize);
	let mut level_dims = Vec::with_capacity(levels as usize);
	previous_levels.push(previous.clone());
	next_levels.push(next.clone());
	level_dims.push((image_width, image_height));
	for _ in 1..levels {
		previous_levels.push(crate::image::pyr_down(
			previous_levels
				.last()
				.ok_or_else(|| Error::internal("image::optical_flow_pyr_lk pyramid level missing"))?,
		)?);
		next_levels.push(crate::image::pyr_down(
			next_levels
				.last()
				.ok_or_else(|| Error::internal("image::optical_flow_pyr_lk pyramid level missing"))?,
		)?);
		let (width, height) = level_dims[level_dims.len() - 1];
		level_dims.push((width.div_ceil(2), height.div_ceil(2)));
	}
	let (coarsest_width, coarsest_height) = level_dims[level_dims.len() - 1];
	if coarsest_width < support || coarsest_height < support {
		return Err(Error::invalid_argument(
			"image::optical_flow_pyr_lk requires the coarsest level to fit the full window",
		));
	}
	let next_points = Matrix::allocate(
		previous.runtime(),
		vec![plane_count as usize, point_count as usize, 2],
		state_elements as usize,
		DType::F32,
	)?;
	let status = Matrix::allocate(
		previous.runtime(),
		vec![plane_count as usize, point_count as usize],
		map_elements as usize,
		DType::F32,
	)?;
	let error = Matrix::allocate(
		previous.runtime(),
		vec![plane_count as usize, point_count as usize],
		map_elements as usize,
		DType::F32,
	)?;
	let mut stages = Vec::with_capacity(levels as usize);
	for level in (0..levels).rev() {
		let previous_level = &previous_levels[level as usize];
		let next_level = &next_levels[level as usize];
		let (level_width, level_height) = level_dims[level as usize];
		let level_scale = 0.5f32.powi(level as i32);
		let initialize = u32::from(level == levels - 1);
		let finalize = u32::from(level == 0);
		let {{binding_name:0}} = [{{bindings:0}}];
		let {{push_name:0}} = [{{push:0}}];
		stages.push(({{kernel:0}}, {{binding_name:0}}, {{push_name:0}}));
	}
	let attributes = [{{attributes}}];
	let dispatches: Vec<ComputeDispatch> = stages
		.iter()
		.map(|(kernel, buffers, push_constants)| ComputeDispatch {
			kernel: *kernel,
			buffers: buffers.as_slice(),
			push_constants: push_constants.as_slice(),
			workgroups: {{workgroups:0}},
			indirect: None,
		})
		.collect();
	previous.runtime().record_image_split_semantic(
		&dispatches,
		ImageSemanticDispatch {
			contract,
			inputs: &[
				ImageSemanticInput::Image(previous),
				ImageSemanticInput::Image(next),
				ImageSemanticInput::Matrix(points),
			],
			outputs: &[
				ImageSemanticOutput::Matrix(&next_points),
				ImageSemanticOutput::Matrix(&status),
				ImageSemanticOutput::Matrix(&error),
			],
			attributes: &attributes,
		},
	)?;
	Ok((next_points, status, error))
// @operation optical_flow_farneback
	let (batch, channels, image_height, image_width) =
		validate_accumulation_pair(previous, next, "image::optical_flow_farneback")?;
	if levels == 0
		|| window == 0
		|| iterations == 0
		|| poly_n == 0
		|| !poly_sigma.is_finite()
		|| poly_sigma <= 0.0
	{
		return Err(Error::invalid_argument(
			"image::optical_flow_farneback requires levels/window/iterations/poly_n >= 1 and finite poly_sigma > 0",
		));
	}
	let poly_support = poly_n
		.checked_mul(2)
		.and_then(|value| value.checked_add(1))
		.ok_or_else(|| Error::out_of_range("image::optical_flow_farneback poly_n exceeds u32"))?;
	let plane_count = batch
		.checked_mul(channels)
		.ok_or_else(|| Error::out_of_range("image::optical_flow_farneback plane count exceeds u32"))?;
	let contract = {{contract}};
	let mut previous_levels = Vec::with_capacity(levels as usize);
	let mut next_levels = Vec::with_capacity(levels as usize);
	let mut level_dims = Vec::with_capacity(levels as usize);
	previous_levels.push(previous.clone());
	next_levels.push(next.clone());
	level_dims.push((image_width, image_height));
	for _ in 1..levels {
		previous_levels.push(crate::image::pyr_down(
			previous_levels
				.last()
				.ok_or_else(|| Error::internal("image::optical_flow_farneback pyramid level missing"))?,
		)?);
		next_levels.push(crate::image::pyr_down(
			next_levels
				.last()
				.ok_or_else(|| Error::internal("image::optical_flow_farneback pyramid level missing"))?,
		)?);
		let (width, height) = level_dims[level_dims.len() - 1];
		level_dims.push((width.div_ceil(2), height.div_ceil(2)));
	}
	let (coarsest_width, coarsest_height) = level_dims[level_dims.len() - 1];
	if coarsest_width < poly_support || coarsest_height < poly_support {
		return Err(Error::invalid_argument(
			"image::optical_flow_farneback requires the coarsest level to fit the polynomial support",
		));
	}
	let workspace_elements = |planes: u32| -> Result<usize> {
		Ok(planes
			.checked_mul(image_height)
			.and_then(|count| count.checked_mul(image_width))
			.ok_or_else(|| {
				Error::out_of_range("image::optical_flow_farneback workspace size exceeds u32")
			})? as usize)
	};
	let moment_shape = vec![
		plane_count as usize,
		3,
		image_height as usize,
		image_width as usize,
	];
	let poly_shape = vec![
		plane_count as usize,
		5,
		image_height as usize,
		image_width as usize,
	];
	let flow_shape = vec![
		plane_count as usize,
		2,
		image_height as usize,
		image_width as usize,
	];
	let three_planes = plane_count
		.checked_mul(3)
		.ok_or_else(|| Error::out_of_range("image::optical_flow_farneback workspace planes exceed u32"))?;
	let five_planes = plane_count
		.checked_mul(5)
		.ok_or_else(|| Error::out_of_range("image::optical_flow_farneback workspace planes exceed u32"))?;
	let two_planes = plane_count
		.checked_mul(2)
		.ok_or_else(|| Error::out_of_range("image::optical_flow_farneback workspace planes exceed u32"))?;
	let moments_a = Matrix::allocate(
		previous.runtime(),
		moment_shape.clone(),
		workspace_elements(three_planes)?,
		DType::F32,
	)?;
	let moments_b = Matrix::allocate(
		previous.runtime(),
		moment_shape,
		workspace_elements(three_planes)?,
		DType::F32,
	)?;
	let poly1 = Matrix::allocate(
		previous.runtime(),
		poly_shape.clone(),
		workspace_elements(five_planes)?,
		DType::F32,
	)?;
	let poly2 = Matrix::allocate(
		previous.runtime(),
		poly_shape,
		workspace_elements(five_planes)?,
		DType::F32,
	)?;
	let flow_a = Matrix::allocate(
		previous.runtime(),
		flow_shape.clone(),
		workspace_elements(two_planes)?,
		DType::F32,
	)?;
	let flow_b = Matrix::allocate(
		previous.runtime(),
		flow_shape.clone(),
		workspace_elements(two_planes)?,
		DType::F32,
	)?;
	let flow = Matrix::allocate(
		previous.runtime(),
		flow_shape,
		workspace_elements(two_planes)?,
		DType::F32,
	)?;
	let mut stages = Vec::new();
	let mut parent: Option<(&Matrix, u32, u32, bool)> = None;
	for level in (0..levels).rev() {
		let (level_width, level_height) = level_dims[level as usize];
		{
			let expand_input = &previous_levels[level as usize];
			let expand_output = &moments_a;
			let {{binding_name:0}} = [{{bindings:0}}];
			let {{push_name:0}} = [{{push:0}}];
			stages.push((
				{{kernel:0}},
				{{binding_name:0}}.to_vec(),
				{{push_name:0}}.to_vec(),
				{{workgroups:0}},
			));
		}
		{
			let expand_input = &moments_a;
			let expand_output = &poly1;
			let {{binding_name:1}} = [{{bindings:1}}];
			let {{push_name:1}} = [{{push:1}}];
			stages.push((
				{{kernel:1}},
				{{binding_name:1}}.to_vec(),
				{{push_name:1}}.to_vec(),
				{{workgroups:1}},
			));
		}
		{
			let expand_input = &next_levels[level as usize];
			let expand_output = &moments_b;
			let {{binding_name:0}} = [{{bindings:0}}];
			let {{push_name:0}} = [{{push:0}}];
			stages.push((
				{{kernel:0}},
				{{binding_name:0}}.to_vec(),
				{{push_name:0}}.to_vec(),
				{{workgroups:0}},
			));
		}
		{
			let expand_input = &moments_b;
			let expand_output = &poly2;
			let {{binding_name:1}} = [{{bindings:1}}];
			let {{push_name:1}} = [{{push:1}}];
			stages.push((
				{{kernel:1}},
				{{binding_name:1}}.to_vec(),
				{{push_name:1}}.to_vec(),
				{{workgroups:1}},
			));
		}
		let mut estimate: &Matrix = &flow_a;
		let mut estimate_is_a = true;
		for iteration in 0..iterations {
			let (flow_in, init_mode, flow_in_width, flow_in_height, input_is_a) = if iteration == 0
			{
				match parent {
					Some((buffer, width, height, is_a)) => (buffer, 1u32, width, height, is_a),
					None => (&flow_a, 0u32, level_width, level_height, true),
				}
			} else {
				(estimate, 2u32, level_width, level_height, estimate_is_a)
			};
			let output_is_flow = level == 0 && iteration + 1 == iterations;
			let flow_out: &Matrix = if output_is_flow {
				&flow
			} else if input_is_a {
				&flow_b
			} else {
				&flow_a
			};
			let {{binding_name:2}} = [{{bindings:2}}];
			let {{push_name:2}} = [{{push:2}}];
			stages.push((
				{{kernel:2}},
				{{binding_name:2}}.to_vec(),
				{{push_name:2}}.to_vec(),
				{{workgroups:2}},
			));
			estimate = flow_out;
			estimate_is_a = !input_is_a;
		}
		parent = Some((estimate, level_width, level_height, estimate_is_a));
	}
	let attributes = [{{attributes}}];
	let dispatches: Vec<ComputeDispatch> = stages
		.iter()
		.map(|(kernel, buffers, push_constants, workgroups)| ComputeDispatch {
			kernel: *kernel,
			buffers: buffers.as_slice(),
			push_constants: push_constants.as_slice(),
			workgroups: *workgroups,
			indirect: None,
		})
		.collect();
	previous.runtime().record_image_split_semantic(
		&dispatches,
		ImageSemanticDispatch {
			contract,
			inputs: &[
				ImageSemanticInput::Image(previous),
				ImageSemanticInput::Image(next),
			],
			outputs: &[ImageSemanticOutput::Matrix(&flow)],
			attributes: &attributes,
		},
	)?;
	Ok(flow)
// @operation stereo_bm
	let (batch, channels, image_height, image_width) =
		validate_accumulation_pair(left, right, "image::stereo_bm")?;
	if num_disparities == 0 || block_size < 3 || block_size.is_multiple_of(2) {
		return Err(Error::invalid_argument(
			"image::stereo_bm requires num_disparities >= 1 and an odd block_size >= 3",
		));
	}
	let support = block_size
		.checked_sub(1)
		.and_then(|value| value.checked_add(num_disparities))
		.ok_or_else(|| Error::out_of_range("image::stereo_bm support exceeds u32"))?;
	if image_width < support || image_height < block_size {
		return Err(Error::invalid_argument(
			"image::stereo_bm requires the image to fit the block and disparity support",
		));
	}
	let plane_count = batch
		.checked_mul(channels)
		.ok_or_else(|| Error::out_of_range("image::stereo_bm plane count exceeds u32"))?;
	let disp_count = plane_count
		.checked_mul(num_disparities)
		.ok_or_else(|| Error::out_of_range("image::stereo_bm disparity slots exceed u32"))?;
	let block_radius = block_size / 2;
	let plane_elements = (image_height as usize)
		.checked_mul(image_width as usize)
		.ok_or_else(|| Error::out_of_range("image::stereo_bm plane size exceeds u32"))?;
	let cost_volume = Matrix::allocate(
		left.runtime(),
		vec![
			plane_count as usize,
			num_disparities as usize,
			image_height as usize,
			image_width as usize,
		],
		plane_elements
			.checked_mul(disp_count as usize)
			.ok_or_else(|| Error::out_of_range("image::stereo_bm cost volume exceeds u32"))?,
		DType::F32,
	)?;
	let output = Matrix::allocate(
		left.runtime(),
		vec![
			plane_count as usize,
			1,
			image_height as usize,
			image_width as usize,
		],
		plane_elements
			.checked_mul(plane_count as usize)
			.ok_or_else(|| Error::out_of_range("image::stereo_bm output size exceeds u32"))?,
		DType::F32,
	)?;
	let contract = {{contract}};
	let mut stages = Vec::new();
	{
		let {{binding_name:0}} = [{{bindings:0}}];
		let {{push_name:0}} = [{{push:0}}];
		stages.push((
			{{kernel:0}},
			{{binding_name:0}}.to_vec(),
			{{push_name:0}}.to_vec(),
			{{workgroups:0}},
		));
	}
	{
		let {{binding_name:1}} = [{{bindings:1}}];
		let {{push_name:1}} = [{{push:1}}];
		stages.push((
			{{kernel:1}},
			{{binding_name:1}}.to_vec(),
			{{push_name:1}}.to_vec(),
			{{workgroups:1}},
		));
	}
	let attributes = [{{attributes}}];
	let dispatches: Vec<ComputeDispatch> = stages
		.iter()
		.map(|(kernel, buffers, push_constants, workgroups)| ComputeDispatch {
			kernel: *kernel,
			buffers: buffers.as_slice(),
			push_constants: push_constants.as_slice(),
			workgroups: *workgroups,
			indirect: None,
		})
		.collect();
	left.runtime().record_image_split_semantic(
		&dispatches,
		ImageSemanticDispatch {
			contract,
			inputs: &[
				ImageSemanticInput::Image(left),
				ImageSemanticInput::Image(right),
			],
			outputs: &[ImageSemanticOutput::Matrix(&output)],
			attributes: &attributes,
		},
	)?;
	Ok(output)
// @operation reproject_image_to_3d
	if disparity.dtype() != DType::F32 || q.dtype() != DType::F32 {
		return Err(Error::invalid_argument(
			"image::reproject_image_to_3d requires F32 disparity and q matrices",
		));
	}
	if disparity.shape().len() != 4 || disparity.shape()[1] != 1 {
		return Err(Error::invalid_argument(
			"image::reproject_image_to_3d requires a [planes, 1, H, W] disparity matrix",
		));
	}
	if q.shape() != [4, 4] {
		return Err(Error::invalid_argument(
			"image::reproject_image_to_3d requires a [4, 4] q matrix",
		));
	}
	let plane_count = u32::try_from(disparity.shape()[0])
		.map_err(|_| Error::out_of_range("image::reproject_image_to_3d plane count exceeds u32"))?;
	let height = u32::try_from(disparity.shape()[2])
		.map_err(|_| Error::out_of_range("image::reproject_image_to_3d height exceeds u32"))?;
	let width = u32::try_from(disparity.shape()[3])
		.map_err(|_| Error::out_of_range("image::reproject_image_to_3d width exceeds u32"))?;
	if plane_count == 0 || height == 0 || width == 0 {
		return Err(Error::invalid_argument(
			"image::reproject_image_to_3d requires a nonempty disparity matrix",
		));
	}
	let plane_elements = (height as usize)
		.checked_mul(width as usize)
		.ok_or_else(|| Error::out_of_range("image::reproject_image_to_3d plane size exceeds u32"))?;
	let output = Matrix::allocate(
		disparity.runtime(),
		vec![
			plane_count as usize,
			3,
			height as usize,
			width as usize,
		],
		plane_elements
			.checked_mul(3)
			.and_then(|count| count.checked_mul(plane_count as usize))
			.ok_or_else(|| Error::out_of_range("image::reproject_image_to_3d output size exceeds u32"))?,
		DType::F32,
	)?;
	let attributes = [{{attributes}}];
	disparity.runtime().record_image_semantic(
		ComputeDispatch {
			kernel: {{kernel:0}},
			buffers: &[{{bindings:0}}],
			push_constants: &[{{push:0}}],
			workgroups: {{workgroups:0}},
			indirect: None,
		},
		ImageSemanticDispatch {
			contract: {{contract}},
			inputs: &[
				ImageSemanticInput::Matrix(disparity),
				ImageSemanticInput::Matrix(q),
			],
			outputs: &[ImageSemanticOutput::Matrix(&output)],
			attributes: &attributes,
		},
	)?;
	Ok(output)
// @operation fast_nl_means_denoising
	let (batch, channels, image_height, image_width) =
		image_extent(input, "image::fast_nl_means_denoising")?;
	if !h.is_finite() || h <= 0.0 {
		return Err(Error::invalid_argument(
			"image::fast_nl_means_denoising requires a finite positive h",
		));
	}
	if template_window < 3
		|| template_window.is_multiple_of(2)
		|| search_window < 3
		|| search_window.is_multiple_of(2)
	{
		return Err(Error::invalid_argument(
			"image::fast_nl_means_denoising requires odd template_window/search_window >= 3",
		));
	}
	let template_radius = template_window / 2;
	let search_radius = search_window / 2;
	let h_sqr = h * h;
	let output = allocate_like(input, "image::fast_nl_means_denoising")?;
	let attributes = [{{attributes}}];
	input.runtime().record_image_semantic(
		ComputeDispatch {
			kernel: {{kernel:0}},
			buffers: &[{{bindings:0}}],
			push_constants: &[{{push:0}}],
			workgroups: {{workgroups:0}},
			indirect: None,
		},
		ImageSemanticDispatch {
			contract: {{contract}},
			inputs: &[ImageSemanticInput::Image(input)],
			outputs: &[ImageSemanticOutput::Image(&output)],
			attributes: &attributes,
		},
	)?;
	Ok(output)
// @operation pyr_mean_shift_filtering
	let (batch, channels, image_height, image_width) =
		image_extent(input, "image::pyr_mean_shift_filtering")?;
	if !sp.is_finite() || sp <= 0.0 || !sr.is_finite() || sr <= 0.0 {
		return Err(Error::invalid_argument(
			"image::pyr_mean_shift_filtering requires finite positive sp and sr",
		));
	}
	if channels > 4 {
		return Err(Error::invalid_argument(
			"image::pyr_mean_shift_filtering supports at most 4 channels",
		));
	}
	if !(1..=4).contains(&max_level) {
		return Err(Error::invalid_argument(
			"image::pyr_mean_shift_filtering requires max_level in [1, 4]",
		));
	}
	let levels = max_level
		.checked_add(1)
		.ok_or_else(|| Error::out_of_range("image::pyr_mean_shift_filtering max_level exceeds u32"))?;
	let spatial_radius = sp.ceil() as u32;
	let range_radius_sqr = sr * sr;
	let mut level_images = Vec::with_capacity(levels as usize);
	let mut level_dims = Vec::with_capacity(levels as usize);
	level_images.push(input.clone());
	level_dims.push((image_width, image_height));
	for _ in 1..levels {
		level_images.push(crate::image::pyr_down(
			level_images
				.last()
				.ok_or_else(|| Error::internal("image::pyr_mean_shift_filtering pyramid level missing"))?,
		)?);
		let (width, height) = level_dims[level_dims.len() - 1];
		level_dims.push((width.div_ceil(2), height.div_ceil(2)));
	}
	let runtime = input.runtime();
	// `converged[level]` storage: the returned Image for level 0,
	// workspaces[level - 1] for coarser levels. Workspaces are allocated
	// up front because dispatch bindings hold stable `&Storage` borrows.
	let mut workspaces = Vec::with_capacity(levels as usize - 1);
	for level in 1..levels {
		let (level_width, level_height) = level_dims[level as usize];
		let count = (batch as usize)
			.checked_mul(channels as usize)
			.and_then(|value| value.checked_mul(level_height as usize))
			.and_then(|value| value.checked_mul(level_width as usize))
			.ok_or_else(|| {
				Error::out_of_range("image::pyr_mean_shift_filtering workspace exceeds usize")
			})?;
		workspaces.push(Matrix::allocate(
			runtime,
			vec![
				batch as usize,
				channels as usize,
				level_height as usize,
				level_width as usize,
			],
			count,
			DType::F32,
		)?);
	}
	let output = allocate_like(input, "image::pyr_mean_shift_filtering")?;
	let mut stages = Vec::new();
	for level in (0..levels).rev() {
		let (level_width, level_height) = level_dims[level as usize];
		let shift_input = level_images[level as usize].as_matrix();
		let shift_output: &Matrix = if level == 0 {
			output.as_matrix()
		} else {
			&workspaces[level as usize - 1]
		};
		// Levels below the coarsest seed their starting color from the
		// parent's converged result (level + 1, stored at workspaces[level]).
		let (shift_seed, seed_width, seed_height, init_mode) = if level + 1 == levels {
			(shift_input, level_width, level_height, 0u32)
		} else {
			let (seed_width, seed_height) = level_dims[level as usize + 1];
			(&workspaces[level as usize], seed_width, seed_height, 1u32)
		};
		let {{binding_name:0}} = [{{bindings:0}}];
		let {{push_name:0}} = [{{push:0}}];
		stages.push((
			{{kernel:0}},
			{{binding_name:0}}.to_vec(),
			{{push_name:0}}.to_vec(),
			{{workgroups:0}},
		));
	}
	let attributes = [{{attributes}}];
	let dispatches: Vec<ComputeDispatch> = stages
		.iter()
		.map(|(kernel, buffers, push_constants, workgroups)| ComputeDispatch {
			kernel: *kernel,
			buffers: buffers.as_slice(),
			push_constants: push_constants.as_slice(),
			workgroups: *workgroups,
			indirect: None,
		})
		.collect();
	runtime.record_image_split_semantic(
		&dispatches,
		ImageSemanticDispatch {
			contract: {{contract}},
			inputs: &[ImageSemanticInput::Image(input)],
			outputs: &[ImageSemanticOutput::Image(&output)],
			attributes: &attributes,
		},
	)?;
	Ok(output)

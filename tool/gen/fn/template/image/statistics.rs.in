			.checked_mul(image_width)
			.ok_or_else(|| Error::out_of_range("image::orb plane size exceeds u32"))?
	} else {
		max_features
	};
	let level_cap = feature_cap;
	let keypoints = Matrix::allocate(
		input.runtime(),
		vec![plane_count as usize, feature_cap as usize, 6],
		plane_count

			buffers: &{{binding_name:2}},
			push_constants: &{{push_name:2}},
			workgroups: {{workgroups:2}},
		},
	];
	let inputs = [predicted, target];
	let outputs = [&confusion, &per_class, &mean_iou, &pixel_accuracy];
	let attributes = [{{attributes}}];
	engine.record_split_semantic(
		&dispatches,
		SemanticDispatch {
			contract: {{contract}},
			inputs: &inputs,
			outputs: &outputs,
			attributes: &attributes,
		},
	)?;
	Ok(SegmentationMetricsResult {
		confusion,
		per_class,
		mean_iou,
		pixel_accuracy,
	})

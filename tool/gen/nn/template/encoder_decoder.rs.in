/// One pre-normalized decoder block of an encoder-decoder {{name}}.
///
/// Applies causal self-attention, bidirectional cross-attention over the
/// encoder output, and a dense GELU feed-forward stage, each behind a
/// pre-norm residual. The cross-attention stage projects its keys and
/// values from the encoder output on every call, so the same block also
/// serves training and uncached evaluation.
pub struct {{block_type}} {
	model_width: usize,
	hidden_width: usize,
	sequence_length: Cell<usize>,
	num_heads: usize,
	norm_self_attention: Rc<LayerNorm>,
	self_attention: Rc<MultiHeadAttention>,
	norm_cross_attention: Rc<LayerNorm>,
	cross_attention: Rc<MultiHeadAttention>,
	norm_feed_forward: Rc<LayerNorm>,
	feed_forward_input: Rc<Linear>,
	feed_forward_output: Rc<Linear>,
	registry: ModuleRegistry,
}

impl {{block_type}} {
	/// Construct the canonical decoder block with causal self-attention and
	/// bidirectional cross-attention.
	///
	/// # Errors
	///
	/// Returns an error for invalid dimensions or failed child construction.
	pub fn new_with_seed(
		model_width: usize,
		hidden_width: usize,
		sequence_length: usize,
		num_heads: usize,
		epsilon: f32,
		seed: u64,
	) -> Result<Self> {
		Self::new_with_seed_on(&Runtime::current()?, model_width, hidden_width, sequence_length, num_heads, epsilon, seed)
	}

	#[allow(clippy::too_many_arguments)]
	pub fn new_with_seed_on(
		runtime: &Runtime,
		model_width: usize,
		hidden_width: usize,
		sequence_length: usize,
		num_heads: usize,
		epsilon: f32,
		seed: u64,
	) -> Result<Self> {
		if model_width == 0
			|| hidden_width == 0
			|| sequence_length == 0
			|| num_heads == 0
			|| !model_width.is_multiple_of(num_heads)
		{
			return Err(Error::invalid_argument(
				"{{block_type}} requires positive D/FFN/S/H and D divisible by H",
			));
		}
		let norm_self_attention = Rc::new({{norm_constructor}}(runtime, model_width, epsilon)?);
		let self_attention = Rc::new({{attention_constructor}}(
			runtime,
			model_width,
			num_heads,
			sequence_length,
			seed,
		)?);
		let norm_cross_attention = Rc::new({{norm_constructor}}(runtime, model_width, epsilon)?);
		let cross_attention = Rc::new({{attention_constructor}}(
			runtime,
			model_width,
			num_heads,
			sequence_length,
			seed.wrapping_add(6),
		)?);
		let norm_feed_forward = Rc::new({{norm_constructor}}(runtime, model_width, epsilon)?);
		let feed_forward_input = Rc::new({{projection_constructor}}(
			runtime,
			model_width,
			hidden_width,
			seed.wrapping_add(12),
		)?);
		let feed_forward_output = Rc::new({{projection_constructor}}(
			runtime,
			hidden_width,
			model_width,
			seed.wrapping_add(13),
		)?);
		let mut registry = ModuleRegistry::new();
		registry.register_module("{{self_norm_name}}", norm_self_attention.clone())?;
		registry.register_module("{{self_attention_name}}", self_attention.clone())?;
		registry.register_module("{{cross_norm_name}}", norm_cross_attention.clone())?;
		registry.register_module("{{cross_attention_name}}", cross_attention.clone())?;
		registry.register_module("{{dense_norm_name}}", norm_feed_forward.clone())?;
		registry.register_module("{{dense_input_name}}", feed_forward_input.clone())?;
		registry.register_module("{{dense_output_name}}", feed_forward_output.clone())?;
		Ok(Self {
			model_width,
			hidden_width,
			sequence_length: Cell::new(sequence_length),
			num_heads,
			norm_self_attention,
			self_attention,
			norm_cross_attention,
			cross_attention,
			norm_feed_forward,
			feed_forward_input,
			feed_forward_output,
			registry,
		})
	}

	/// Apply pre-norm self-attention, cross-attention over `encoder_output`,
	/// and GELU feed-forward stages behind residuals.
	///
	/// `input` is F32 `[B*S_tgt, D]`; `encoder_output` is F32 `[B*S_src, D]`
	/// on the same runtime for the same batch.
	///
	/// # Errors
	///
	/// Returns an error unless both matrices satisfy their geometry and
	/// dtype contracts, or a child operation fails.
	pub fn forward(&self, input: &Matrix, encoder_output: &Matrix) -> Result<Matrix> {
		let normalized = self.norm_self_attention.forward(input)?;
		let attended = self.self_attention.forward(&normalized)?;
		let residual = matrix::add(input, &attended)?;
		let normalized = self.norm_cross_attention.forward(&residual)?;
		let attended = self
			.cross_attention
			.forward_kv(&normalized, encoder_output)?;
		let residual = matrix::add(&residual, &attended)?;
		let normalized = self.norm_feed_forward.forward(&residual)?;
		let hidden = {{activation_operation}}(&self.feed_forward_input.forward(&normalized)?)?;
		let projected = self.feed_forward_output.forward(&hidden)?;
		matrix::add(&residual, &projected)
	}

	pub const fn model_width(&self) -> usize {
		self.model_width
	}
	pub const fn hidden_width(&self) -> usize {
		self.hidden_width
	}
	pub fn sequence_length(&self) -> usize {
		self.sequence_length.get()
	}
	pub const fn num_heads(&self) -> usize {
		self.num_heads
	}

	/// Change runtime target sequence geometry without rebuilding parameters.
	///
	/// # Errors
	///
	/// Returns an error when `sequence_length` is zero.
	pub fn set_sequence_length(&self, sequence_length: usize) -> Result<()> {
		self.self_attention.set_sequence_length(sequence_length)?;
		self.cross_attention.set_sequence_length(sequence_length)?;
		self.sequence_length.set(sequence_length);
		Ok(())
	}
}

impl Module for {{block_type}} {
	fn forward(&self, input: &Matrix) -> Result<Matrix> {
		let _ = input;
		Err(Error::invalid_argument(
			"{{block_type}} requires encoder output; call {{block_type}}::forward(input, encoder_output)",
		))
	}
	fn registry(&self) -> &ModuleRegistry {
		&self.registry
	}
}

/// {{doc}}
///
/// Source and target token/position embeddings feed separate block stacks:
/// encoder blocks run bidirectional self-attention, decoder blocks run
/// causal self-attention and bidirectional cross-attention over the encoder
/// output. `forward(source, target)` returns all-position target logits.
pub struct {{name}} {
	source_vocab_size: usize,
	target_vocab_size: usize,
	source_context_length: usize,
	target_context_length: usize,
	model_width: usize,
	hidden_width: usize,
	num_heads: usize,
	source_token_embedding: Rc<super::Embedding>,
	source_position_embedding: Rc<super::Embedding>,
	target_token_embedding: Rc<super::Embedding>,
	target_position_embedding: Rc<super::Embedding>,
	encoder_blocks: Vec<Rc<TransformerBlock>>,
	decoder_blocks: Vec<Rc<{{block_type}}>>,
	encoder_norm: Rc<LayerNorm>,
	decoder_norm: Rc<LayerNorm>,
	head: Rc<Linear>,
	registry: ModuleRegistry,
}

impl {{name}} {
	/// Construct a deterministic encoder-decoder Transformer.
	///
	/// Both stacks use `num_layers` blocks of the same width recipe.
	///
	/// # Errors
	///
	/// Returns an error unless all dimensions are positive, the model width
	/// is divisible by the head count, positions fit U32, and every child
	/// can be constructed and registered.
	#[allow(clippy::too_many_arguments)]
	pub fn new_with_seed(
		source_vocab_size: usize,
		target_vocab_size: usize,
		source_context_length: usize,
		target_context_length: usize,
		model_width: usize,
		hidden_width: usize,
		num_layers: usize,
		num_heads: usize,
		epsilon: f32,
		seed: u64,
	) -> Result<Self> {
		Self::new_with_seed_on(&Runtime::current()?, source_vocab_size, target_vocab_size, source_context_length, target_context_length, model_width, hidden_width, num_layers, num_heads, epsilon, seed)
	}

	#[allow(clippy::too_many_arguments)]
	pub fn new_with_seed_on(
		runtime: &Runtime,
		source_vocab_size: usize,
		target_vocab_size: usize,
		source_context_length: usize,
		target_context_length: usize,
		model_width: usize,
		hidden_width: usize,
		num_layers: usize,
		num_heads: usize,
		epsilon: f32,
		seed: u64,
	) -> Result<Self> {
		if source_vocab_size == 0
			|| target_vocab_size == 0
			|| source_context_length == 0
			|| target_context_length == 0
			|| model_width == 0
			|| hidden_width == 0
			|| num_layers == 0
			|| num_heads == 0
			|| !model_width.is_multiple_of(num_heads)
			|| u32::try_from(source_context_length - 1).is_err()
			|| u32::try_from(target_context_length - 1).is_err()
		{
			return Err(Error::invalid_argument(
				"{{name}} requires positive dimensions, D divisible by H, and U32 positions",
			));
		}
		let source_token_embedding = Rc::new({{embedding_constructor}}(
			runtime,
			source_vocab_size,
			model_width,
			seed,
		)?);
		let source_position_embedding = Rc::new({{embedding_constructor}}(
			runtime,
			source_context_length,
			model_width,
			seed.wrapping_add(1),
		)?);
		let target_token_embedding = Rc::new({{embedding_constructor}}(
			runtime,
			target_vocab_size,
			model_width,
			seed.wrapping_add(2),
		)?);
		let target_position_embedding = Rc::new({{embedding_constructor}}(
			runtime,
			target_context_length,
			model_width,
			seed.wrapping_add(3),
		)?);
		let mut registry = ModuleRegistry::new();
		registry.register_module("{{source_token_name}}", source_token_embedding.clone())?;
		registry.register_module("{{source_position_name}}", source_position_embedding.clone())?;
		registry.register_module("{{target_token_name}}", target_token_embedding.clone())?;
		registry.register_module("{{target_position_name}}", target_position_embedding.clone())?;
		let encoder_stride = 6_u64;
		let mut encoder_blocks = Vec::with_capacity(num_layers);
		for index in 0..num_layers {
			let block = Rc::new(TransformerBlock::new_with_seed_on(
				runtime,
				model_width,
				hidden_width,
				source_context_length,
				num_heads,
				epsilon,
				seed.wrapping_add(4 + (index as u64) * encoder_stride),
			)?);
			block.set_attention_mode(AttentionMode::Bidirectional);
			registry.register_module(format!("{{encoder_prefix}}_{index}"), block.clone())?;
			encoder_blocks.push(block);
		}
		let decoder_stride = 16_u64;
		let decoder_base = 4 + (num_layers as u64) * encoder_stride;
		let mut decoder_blocks = Vec::with_capacity(num_layers);
		for index in 0..num_layers {
			let block = Rc::new({{block_type}}::new_with_seed_on(
				runtime,
				model_width,
				hidden_width,
				target_context_length,
				num_heads,
				epsilon,
				seed.wrapping_add(decoder_base + (index as u64) * decoder_stride),
			)?);
			registry.register_module(format!("{{decoder_prefix}}_{index}"), block.clone())?;
			decoder_blocks.push(block);
		}
		let encoder_norm = Rc::new({{norm_constructor}}(runtime, model_width, epsilon)?);
		let decoder_norm = Rc::new({{norm_constructor}}(runtime, model_width, epsilon)?);
		let head_seed = seed.wrapping_add(decoder_base + (num_layers as u64) * decoder_stride);
		let head = Rc::new({{projection_constructor}}(
			runtime,
			model_width,
			target_vocab_size,
			head_seed,
		)?);
		registry.register_module("{{encoder_norm_name}}", encoder_norm.clone())?;
		registry.register_module("{{decoder_norm_name}}", decoder_norm.clone())?;
		registry.register_module("{{head_name}}", head.clone())?;
		Ok(Self {
			source_vocab_size,
			target_vocab_size,
			source_context_length,
			target_context_length,
			model_width,
			hidden_width,
			num_heads,
			source_token_embedding,
			source_position_embedding,
			target_token_embedding,
			target_position_embedding,
			encoder_blocks,
			decoder_blocks,
			encoder_norm,
			decoder_norm,
			head,
			registry,
		})
	}

	/// Embed source tokens `tokens`, a U8/U32 `[batch, source_context]`
	/// matrix, through the encoder stack.
	///
	/// # Errors
	///
	/// Returns an error unless `tokens` is nonempty U8 or U32 `[batch,
	/// source_context_length]`, or a child operation fails.
	pub fn encode(&self, tokens: &Matrix) -> Result<Matrix> {
		let (batch, sequence) = Self::token_geometry(tokens, self.source_context_length)?;
		let rows = batch
			.checked_mul(sequence)
			.ok_or_else(|| Error::invalid_argument("{{name}} row count overflows usize"))?;
		let mut value = self.embed(tokens, &self.source_token_embedding, &self.source_position_embedding, rows, self.source_context_length)?;
		for block in &self.encoder_blocks {
			value = block.forward(&value)?;
		}
		self.encoder_norm.forward(&value)
	}

	/// Evaluate all-position target logits for `tokens`, a U8/U32 `[batch,
	/// target_context]` matrix, against a computed `encoder_output`.
	///
	/// `encoder_output` must be F32 `[batch*source_context_length,
	/// model_width]` on the same runtime — normally the result of
	/// [`Self::encode`].
	///
	/// # Errors
	///
	/// Returns an error unless `tokens` and `encoder_output` satisfy their
	/// geometry, dtype, and runtime contracts, or a child operation fails.
	pub fn decode(&self, tokens: &Matrix, encoder_output: &Matrix) -> Result<Matrix> {
		let (batch, sequence) = Self::token_geometry(tokens, self.target_context_length)?;
		let [encoder_rows, encoder_width] = encoder_output.shape() else {
			return Err(Error::invalid_argument(
				"{{name}} encoder output must have shape [batch*source_context, D]",
			));
		};
		if encoder_output.dtype() != DType::F32
			|| *encoder_width != self.model_width
			|| *encoder_rows != batch * self.source_context_length
			|| !tokens
				.runtime()
				.same_as(encoder_output.runtime())
		{
			return Err(Error::invalid_argument(format!(
				"{{name}} requires same-runtime F32 encoder output [{}, {}]; found {:?} {}",
				batch * self.source_context_length,
				self.model_width,
				encoder_output.shape(),
				encoder_output.dtype().token(),
			)));
		}
		let rows = batch
			.checked_mul(sequence)
			.ok_or_else(|| Error::invalid_argument("{{name}} row count overflows usize"))?;
		let mut value = self.embed(tokens, &self.target_token_embedding, &self.target_position_embedding, rows, self.target_context_length)?;
		for block in &self.decoder_blocks {
			value = block.forward(&value, encoder_output)?;
		}
		self.head.forward(&self.decoder_norm.forward(&value)?)
	}

	/// Encode `source` and decode `target`, returning `[batch*target_context,
	/// target_vocab]` logits.
	///
	/// # Errors
	///
	/// Returns an error under the [`Self::encode`] and [`Self::decode`]
	/// contracts.
	pub fn forward(&self, source: &Matrix, target: &Matrix) -> Result<Matrix> {
		self.decode(target, &self.encode(source)?)
	}

	fn token_geometry(tokens: &Matrix, context_length: usize) -> Result<(usize, usize)> {
		let [batch, sequence] = tokens.shape() else {
			return Err(Error::invalid_argument(
				"{{name}} tokens must have shape [batch, context_length]",
			));
		};
		if *batch == 0
			|| *sequence != context_length
			|| !matches!(tokens.dtype(), DType::U8 | DType::U32)
		{
			return Err(Error::invalid_argument(format!(
				"{{name}} tokens must be nonempty U8 or U32 [batch, {context_length}]"
			)));
		}
		Ok((*batch, *sequence))
	}

	fn embed(
		&self,
		tokens: &Matrix,
		token_embedding: &super::Embedding,
		position_embedding: &super::Embedding,
		rows: usize,
		context_length: usize,
	) -> Result<Matrix> {
		let position_values = (0..rows)
			.map(|index| (index % context_length) as u32)
			.collect::<Vec<_>>();
		let position_ids = Matrix::new_from_slice_handle(
			tokens.runtime(),
			vec![rows],
			&position_values,
		)?;
		let token_values = token_embedding.forward(tokens)?.reshape([rows, self.model_width])?;
		let position_values = position_embedding.forward(&position_ids)?;
		matrix::add(&token_values, &position_values)
	}

	pub const fn source_vocab_size(&self) -> usize {
		self.source_vocab_size
	}
	pub const fn target_vocab_size(&self) -> usize {
		self.target_vocab_size
	}
	pub const fn source_context_length(&self) -> usize {
		self.source_context_length
	}
	pub const fn target_context_length(&self) -> usize {
		self.target_context_length
	}
	pub const fn model_width(&self) -> usize {
		self.model_width
	}
	pub const fn hidden_width(&self) -> usize {
		self.hidden_width
	}
	pub fn num_layers(&self) -> usize {
		self.encoder_blocks.len()
	}
	pub const fn num_heads(&self) -> usize {
		self.num_heads
	}

	/// Return one encoder block by layer index.
	pub fn encoder_block(&self, index: usize) -> Option<&TransformerBlock> {
		self.encoder_blocks.get(index).map(Rc::as_ref)
	}

	/// Return one decoder block by layer index.
	pub fn decoder_block(&self, index: usize) -> Option<&{{block_type}}> {
		self.decoder_blocks.get(index).map(Rc::as_ref)
	}
}

impl Module for {{name}} {
	fn forward(&self, input: &Matrix) -> Result<Matrix> {
		let _ = input;
		Err(Error::invalid_argument(
			"{{name}} requires source and target tokens; call {{name}}::forward(source, target)",
		))
	}
	fn registry(&self) -> &ModuleRegistry {
		&self.registry
	}
}
